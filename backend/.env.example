# FastAPI Backend Configuration
APP_NAME="Aurora Store API"
ENVIRONMENT=development
DEBUG=true

# Neon PostgreSQL Database (Pooled connection recommended)
DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@<HOST>/ecommerce?sslmode=require

# Session Secret (Min 32 characters HMAC secret)
SESSION_SECRET=change-this-to-a-very-secure-random-secret-key-32chars

# Firebase Authentication (Optional in local test mode)
FIREBASE_PROJECT_ID=aurora-store
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
AUTH_TEST_MODE=true

# Paytm Payment Gateway (Staging / Production)
PAYTM_ENVIRONMENT=staging
PAYTM_MID=YOUR_PAYTM_MID_HERE
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY_HERE
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CALLBACK_URL=http://localhost:8000/api/v1/payments/paytm/callback
PAYTM_FRONTEND_RETURN_URL=http://localhost:3000/orders
