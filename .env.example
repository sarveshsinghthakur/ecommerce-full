# ---------------------------------------------------------------------------
# Aurora Store — environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or paste real secrets into this template.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) -------------------------------------------
# Serverless pooled connection string from the Neon console.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# Optional: direct (non-pooled) URL used by migration tooling when the pooled
# proxy is unsuitable for DDL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Aurora Store"

# --- Authentication (Firebase) --------------------------------------------
# Public web config — safe to expose to the browser (Firebase web API keys are
# not secrets, they are protected by authorized domains + Security Rules).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server-only. A service account JSON (preferred) OR the individual fields.
# Used exclusively by the Firebase Admin SDK to verify ID tokens / session cookies.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# --- Admin access (fail closed when empty) --------------------------------
# Comma-separated list of email addresses allowed into /admin.
# Optionally also pin exact Firebase UIDs.
ADMIN_EMAILS="owner@example.com"
# ADMIN_UIDS=""
# Set to "true" on a developer machine to allow password-less sign-in by email
# while Firebase credentials are unavailable. The session route refuses this
# whenever NODE_ENV=production, regardless of the flag.
# AUTH_TEST_MODE="true"

# --- AI (Mistral) ---------------------------------------------------------
# Server-side only. Never expose to the client.
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# --- Payments (Razorpay) --------------------------------------------------
# Leave empty to run the checkout in explicit TEST/UNCONFIGURED mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Pricing --------------------------------------------------------------
# Global default markup percentage applied over the source price.
# Allowed presets: 8, 9, 10, or any custom number between 0 and 100.
DEFAULT_MARKUP_PERCENT="9"
DEFAULT_CURRENCY="INR"

# --- Operational ----------------------------------------------------------
# Shared secret used to sign internal short-lived tokens (cart merge, CSRF).
APP_SECRET="replace-with-a-long-random-string"
# Requests per minute for sensitive endpoints (search, chat, import, contact).
RATE_LIMIT_SEARCH="60"
RATE_LIMIT_CHAT="12"
RATE_LIMIT_IMPORT="6"
RATE_LIMIT_CONTACT="5"

# --- Optional: local development overrides --------------------------------
# Skip live marketplace network calls during import (uses fixtures instead).
# IMPORT_OFFLINE="true"
